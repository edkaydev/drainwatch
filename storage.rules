rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validImage(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && fileName.size() <= 160
        && fileName.matches('.*\\.(jpg|jpeg|png|webp)$');
    }

    function validIncidentId(incidentId) {
      return incidentId.matches('^[A-Za-z0-9]{10,64}$');
    }

    // The cover photo is intentionally writable by anonymous reporters because
    // public reporting does not require an account. It is content, size, and
    // filename validated, but there is no per-user quota at the Storage layer.
    match /public-incident-photos/{incidentId}/{fileName} {
      allow read: if true;
      allow create: if validIncidentId(incidentId) && validImage(fileName);
      allow update, delete: if false;
    }

    // Additional evidence photos are private. Requiring auth prevents the
    // public cover-photo path from being reused for arbitrary private uploads.
    match /incident-photos/{incidentId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && validIncidentId(incidentId)
        && validImage(fileName);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
