rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function validImage(fileName) {
      return request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && fileName.matches('.*\\.(jpg|jpeg|png|webp)$');
    }

    match /public-incident-photos/{incidentId}/{fileName} {
      allow read: if true;
      allow create: if validImage(fileName);
      allow update, delete: if false;
    }

    match /incident-photos/{incidentId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if validImage(fileName);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
