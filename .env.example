# Copy this file to .env.local and fill in the values for your Firebase project.
# Never commit .env.local or any real keys.

# ---------------------------------------------------------------------------
# Firebase web app configuration (safe to expose to the browser)
# Firebase Console -> Project settings -> Your apps -> Web app -> SDK setup
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: enables the internal staff "who's online" presence indicator.
# Firebase Console -> Realtime Database -> create a database -> copy its URL.
# Leave blank to disable presence; nothing else depends on it.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# ---------------------------------------------------------------------------
# Server-only Gemini configuration (never expose these to the browser)
# Leave the key blank to use the deterministic rule-based fallback.
# ---------------------------------------------------------------------------
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# Deployment metadata
# ---------------------------------------------------------------------------
# Canonical origin used for metadata, robots.txt, and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional MapLibre style override. Defaults to OpenFreeMap Liberty.
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# ---------------------------------------------------------------------------
# Optional: credentials used only by `npm run verify:firebase`
# Create a dedicated staff test account; do not use a personal admin account.
# ---------------------------------------------------------------------------
DRAINWATCH_STAFF_EMAIL=
DRAINWATCH_STAFF_PASSWORD=
DRAINWATCH_APP_URL=http://localhost:3000
